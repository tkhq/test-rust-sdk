{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "fixture-worker",
        "namespace": "fixture-lab"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "fixture-worker",
        "namespace": "fixture-lab"
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "secrets"
          ],
          "verbs": [
            "get",
            "list"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "fixture-worker",
        "namespace": "fixture-lab"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "fixture-worker",
          "namespace": "fixture-lab"
        }
      ],
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "fixture-worker"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "fixture-workload",
        "namespace": "fixture-lab"
      },
      "spec": {
        "serviceAccountName": "fixture-worker",
        "containers": [
          {
            "name": "worker",
            "image": "example.invalid/worker:fixture",
            "volumeMounts": [
              {
                "name": "worker-api",
                "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
                "readOnly": true
              }
            ]
          }
        ],
        "automountServiceAccountToken": false,
        "volumes": [
          {
            "name": "worker-api",
            "projected": {
              "sources": [
                {
                  "serviceAccountToken": {
                    "path": "token",
                    "expirationSeconds": 3600
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
